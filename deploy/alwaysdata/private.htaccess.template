# Ce fichier est installé uniquement sur l'instance de démonstration.
Options -Indexes -MultiViews
DirectoryIndex index.php
FallbackResource /index.php

AuthType Basic
AuthName "BacklineBridge - Demonstration privee"
AuthUserFile "{{AUTH_USER_FILE}}"
Require valid-user

# Le proxy alwaysdata retire les valeurs fournies par le client et indique le protocole réel.
SetEnvIf X-Forwarded-Proto "^https$" HTTPS=on

# Apache reçoit les connexions du proxy en HTTP : ne pas utiliser sa variable HTTPS.
<If "req('X-Forwarded-Proto') != 'https'">
    Require all denied
</If>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(?!index\.php$).*\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cache-Control "private, no-store"
</IfModule>

# BEGIN BacklineBridge asset cache
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>
# Seuls les fichiers statiques versionnés peuvent être conservés dans le navigateur.
# Les pages, documents privés et erreurs gardent la règle no-store ci-dessus.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|svg|ico|png|woff2?)$">
        Header always set Cache-Control "private, max-age=31536000, immutable" "expr=(%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304) && %{QUERY_STRING} =~ m#(^|&)v=[a-f0-9]{16}(&|$)#"
    </FilesMatch>
</IfModule>
# END BacklineBridge asset cache
