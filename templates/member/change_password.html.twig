{% extends 'base.html.twig' %}

{% block title %}
    Changer mon mot de passe · {{ app_name }}
{% endblock %}

{% block body %}
    <section class="workspace-panel activation-card">
        <p class="eyebrow">
            Mon compte
        </p>
        <h1>Changer mon mot de passe</h1>
        <p>
            Renseigne ton mot de passe actuel, puis choisis et confirme le nouveau.
        </p>
        {{
            form_start(
                form,
                {
                    attr: {
                        novalidate: 'novalidate'
                    }
                }
            )
        }}
        {{ form_errors(form) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.password) }}
        <button class="button button-primary" type="submit">Enregistrer mon mot de passe</button>
        {{ form_end(form) }}
        <a href="{{ path('app_concert_index') }}">← Retour aux concerts</a>
    </section>
{% endblock %}
