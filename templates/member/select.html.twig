{% extends 'base.html.twig' %}
{% block title %}
    Première connexion · {{ app_name }}
{% endblock %}
{% block body %}
    <section class="workspace-panel activation-card">
        <p class="eyebrow">
            Bienvenue dans le groupe
        </p>
        <h1>Qui es-tu ?</h1>
        <p>
            Choisis ton nom, puis utilise le code personnel transmis pour créer ton mot de passe.
        </p>
        {% if form is not null %}
            {{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.profile) }}<button
                class="button button-primary"
                type="submit"
            >
                Continuer
            </button>{{ form_end(form) }}
        {% else %}
            <p class="workspace-hint">
                Aucun compte en attente d’activation. Si ton code a expiré, demande un nouveau code
                au responsable de l’application.
            </p>
        {% endif %}<a href="{{ path('app_login') }}">J’ai déjà mon mot de passe →</a>
    </section>
{% endblock %}
