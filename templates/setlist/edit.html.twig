{% extends 'base.html.twig' %}
{% set concert = sheet.concert %}
{% set returnUrl = concert
    ? path(
        'app_concert_show',
        {
            id: concert.id,
            _fragment: 'setlist'
        }
    )
    : path(
        'app_patch_index',
        {
            _fragment: 'setlist'
        }
    )
%}
{% block title %}
    {{ concert ? 'Setlist du concert' : 'Setlist de référence' }} · {{ app_name }}
{% endblock %}
{% block page_assets %}
    <link rel="stylesheet" href="/styles/setlist.css" />
{% endblock %}
{% block body %}
    <a class="back-link" href="{{ returnUrl }}">
        ← {{ concert ? 'Revenir au concert' : 'Revenir à la fiche technique' }}
    </a>
    <section class="form-heading" aria-labelledby="page-title">
        <p class="eyebrow">
            {{ sheet.bandName }}{{ concert ? ' · ' ~ concert.venue ~ ' · ' ~ (concert.date|date('d/m/Y')) : '' }}
        </p>
        <h1 id="page-title">
            {{ concert ? 'Setlist du concert' : 'Setlist de référence' }}<span class="title-period">.</span>
        </h1>
        <p>
            {{ concert
                ? 'Cette version reste propre à cette date.'
                : 'Prépare les titres que vous pourrez importer dans vos concerts.' }}
        </p>
    </section>
    <section class="form-panel setlist-editor">
        {{
            form_start(
                form,
                {
                    attr: {
                        class: 'setlist-form',
                        novalidate: 'novalidate'
                    }
                }
            )
        }}
        {% if form.vars.errors|length %}
            <div class="form-error-summary" role="alert">
                {{ form_errors(form) }}
            </div>
        {% endif %}
        {% if conflict %}
            <p class="setlist-reload">
                <a
                    href="{{
                    path(
                        'app_setlist_edit',
                        {
                            id: sheet.id
                        }
                    )
                    }}"
                >
                    Recharger la version actuelle
                </a>
            </p>
        {% endif %}
        <div class="field">
            {{ form_label(form.songs) }}
            {{ form_widget(form.songs) }}
            <div class="field-errors">
                {{ form_errors(form.songs) }}
            </div>
            {{ form_help(form.songs) }}
        </div>
        <div class="setup-actions">
            <button type="submit" class="button button-primary">Enregistrer la setlist</button>
            <a class="button button-secondary" href="{{ returnUrl }}">Annuler</a>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
