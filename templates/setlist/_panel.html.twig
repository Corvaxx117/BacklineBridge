{% set concert = sheet.concert %}
{% set tracks = setlist ? setlist.tracks : [] %}
<details
    id="setlist"
    class="setlist-panel"
    data-concert-section
    data-sheet-section
    aria-labelledby="setlist-title"
>
    <summary>
        <h2 id="setlist-title">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
            >
                <path d="M9 18V5l11-2v13M9 8l11-2" />
                <ellipse cx="6" cy="18" rx="3" ry="2.5" />
                <ellipse cx="17" cy="16" rx="3" ry="2.5" />
            </svg>
            <span>Setlist</span>
            <span class="setlist-count">
                {{ tracks|length
                    ? (tracks|length) ~ ((tracks|length) == 1 ? ' titre' : ' titres')
                    : 'Aucun titre' }}
            </span>
        </h2>
    </summary>
    <div class="setlist-content">
        {% if is_granted('BAND_SETLIST', sheet.band) %}
            <div class="setlist-actions">
                {% if
                    concert
                        and referenceSetlist is defined
                        and referenceSetlist
                        and referenceSetlist.tracks is not empty %}
                    <a
                        class="setlist-action"
                        href="{{
                        path(
                            'app_setlist_import',
                            {
                                id: concert.id
                            }
                        )
                        }}"
                        title="Importer la setlist de référence pour ce concert"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            aria-hidden="true"
                        >
                            <path d="M12 3v12m-4-4 4 4 4-4M5 15v5h14v-5" />
                        </svg>Importer la référence
                    </a>
                {% endif %}
                <a
                    class="setlist-action"
                    href="{{
                    path(
                        'app_setlist_edit',
                        {
                            id: sheet.id
                        }
                    )
                    }}"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                    >
                        <path d="m15 5 4 4M4 20l5-1L20 8a2.8 2.8 0 0 0-4-4L5 15l-1 5Z" />
                    </svg>
                    {{ tracks is empty ? 'Créer la setlist' : 'Modifier' }}
                </a>
            </div>
        {% endif %}
        {{
            include(
                'setlist/_tracks.html.twig',
                {
                    tracks: tracks,
                    emptyMessage: concert
                        ? 'Aucune setlist définie pour cette date.'
                        : 'La setlist de référence du groupe est à définir.'
                },
                with_context: false
            )
        }}
        <p class="setlist-caption">
            {{ concert ? 'Version propre à ce concert.' : 'Référence du groupe.' }} Interne à l’équipe.{% if
                setlist %}
                <span>
                    Modifiée par {{ setlist.updatedByName }}, le {{
                        setlist.updatedAt|date('d/m/Y à H:i', 'Europe/Paris')
                    }}.
                </span>
            {% endif %}
        </p>
    </div>
</details>
