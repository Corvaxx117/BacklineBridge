<div class="theme-control" role="group" aria-label="Apparence" data-theme-control hidden>
    <button
        class="theme-switch"
        type="button"
        role="switch"
        aria-label="Mode sombre"
        aria-checked="false"
        title="Activer le mode sombre"
        data-theme-toggle
    >
        <span class="theme-switch-thumb" aria-hidden="true"></span>
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <circle cx="12" cy="12" r="4" />
            <path
                d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
            />
        </svg>
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <path d="M20.5 13.3A8.5 8.5 0 0 1 10.7 3.5a8.5 8.5 0 1 0 9.8 9.8Z" />
        </svg>
    </button>
    <span class="theme-control-divider" aria-hidden="true"></span>
    <button
        class="theme-auto"
        type="button"
        aria-label="Suivre le thème de l’appareil"
        aria-pressed="true"
        title="Thème automatique activé"
        data-theme-auto
    >
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <rect x="3" y="4" width="18" height="13" rx="2" />
            <path d="M8 21h8m-4-4v4" />
        </svg>
    </button>
</div>
