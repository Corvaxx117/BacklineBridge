<div class="stage-viewer" data-stage-viewer>
    <div
        class="stage-zoom-controls"
        data-stage-zoom-controls
        role="group"
        aria-label="Zoom du plan de scène"
        hidden
    >
        <button type="button" data-stage-zoom="out" aria-label="Réduire le zoom du plan">−</button>
        <output data-stage-zoom-value aria-label="Niveau de zoom du plan">
            100 %
        </output>
        <button type="button" data-stage-zoom="in" aria-label="Agrandir le plan">+</button>
        <button type="button" data-stage-zoom="fit" aria-pressed="true">Vue d’ensemble</button>
    </div>
    <div class="stage-scroll" tabindex="0" aria-label="Plan de scène, vue depuis le public">
        <div class="stage-viewport" data-stage-viewport>
            <div
                class="stage-board"
                style="--stage-base-scale: {{ stage_base_scale() }};"
                {{ editable|default(false) ? 'data-stage-board' : '' }}
            >
                <span class="stage-orientation stage-back">Fond de scène</span>
                {% for item in items %}
                    {% set caption = item.notes|split('·')|first|trim %}
                    <div
                        class="stage-node stage-{{ item.kind }} {{
                        item.kind == 'power' and item.label == 'Alimentation'
                            ? 'stage-symbol-only'
                            : ''
                        }}"
                        data-technical-family="{{ item.family|default(
                            technical_stage_family(item)
                        ) }}"
                        title="{{ item.label }}{{ item.notes ? ' · ' ~ item.notes : '' }}"
                        style="left: {{ item.x|number_format(
                            1,
                            '.',
                            ''
                        ) }}%; top: {{ item.y|number_format(
                            1,
                            '.',
                            ''
                        ) }}%; --stage-rotation: {{ item.rotation
                            |default(0)
                            |number_format(1, '.', '') }}deg; --stage-scale: {{ item.scale
                            |default(1)
                            |number_format(2, '.', '') }};"
                    >
                        <span class="stage-symbol" aria-hidden="true">
                            {{
                                include(
                                    'stage/_icon.html.twig',
                                    {
                                        kind: item.kind
                                    },
                                    with_context: false
                                )
                            }}
                        </span>
                        <strong>{{ item.label }}</strong>
                        <small>{{ (caption|length) <= 32 ? caption : '' }}</small>
                        {% if item.patchLabel|default('') %}
                            <span
                                class="stage-patch-badge {{
                                item.patchMissing|default(0)
                                    ? 'has-missing-source'
                                    : ''
                                }}"
                            >
                                {{ item.patchLabel }}
                            </span>
                        {% endif %}
                    </div>
                {% endfor %}
                <span class="stage-orientation stage-front">Public · avant-scène</span>
            </div>
        </div>
    </div>
</div>

{% if items %}
    <details class="stage-legend">
        <summary>
            Repères et précisions · {{ items|length }} éléments
        </summary>
        <dl>
            {% for item in items %}
                <div>
                    <dt
                        data-technical-family="{{ item.family|default(
                            technical_stage_family(item)
                        ) }}"
                    >
                        {{ item.label }}
                    </dt>
                    <dd>
                        {{ item.notes ? : 'Pas de précision supplémentaire.' }}{% if
                            item.patchLabel|default('') %}
                            · {{ item.patchLabel }}
                        {% endif %}
                    </dd>
                </div>
            {% endfor %}
        </dl>
    </details>
{% endif %}
