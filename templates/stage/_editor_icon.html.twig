<svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {% if icon in ['undo', 'rotate-left'] %}
        <path d="M3 10a9 9 0 1 1 1.7 8M3 4v6h6" />
    {% elseif icon in ['redo', 'rotate-right'] %}
        <path d="M21 10a9 9 0 1 0-1.7 8M21 4v6h-6" />
    {% elseif icon == 'minus' %}
        <path d="M5 12h14" />
    {% elseif icon == 'plus' %}
        <path d="M5 12h14m-7-7v14" />
    {% elseif icon == 'text' %}
        <path d="M4 5h16M12 5v15m-5 0h10" />
    {% elseif icon == 'duplicate' %}
        <rect x="8" y="8" width="13" height="13" rx="2" />
        <path d="M16 8V3H3v13h5" />
    {% elseif icon == 'trash' %}
        <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7m4-7v7" />
    {% endif %}
</svg>
