{% extends 'base.html.twig' %}

{% set documentHeading = source.value == 'pdf' ? 'Ajouter un PDF' : 'Ajouter un lien' %}
{% if roadmap %}
    {% set documentHeading = 'Ajouter la feuille de route' %}
{% endif %}
{% set returnUrl = concertContext
    ? path(
        'app_concert_show',
        {
            id: concertContext.id,
            _fragment: 'concert-documents'
        }
    )
    : path(
        'app_document_index',
        {
            id: band.id
        }
    )
%}

{% block title %}
    {{ documentHeading }} · {{ app_name }}
{% endblock %}

{% block body %}
    <a class="back-link" href="{{ returnUrl }}">
        {{ concertContext ? '← Revenir au concert' : '← Revenir aux documents' }}
    </a>
    <section class="form-heading" aria-labelledby="page-title">
        <p class="eyebrow">
            {{ band.name }} / {{ concertContext
                ? concertContext.venue ~ ' · ' ~ (concertContext.date|date('d/m/Y'))
                : 'Documents' }}
        </p>
        <h1 id="page-title">{{ documentHeading }}<span class="title-period">.</span></h1>
        <p>
            {{ source.value == 'pdf'
                ? 'Le PDF sera accessible à l’équipe depuis BacklineBridge.'
                : 'Le fichier reste chez son hébergeur. BacklineBridge garde son lien et les informations utiles.' }}
        </p>
    </section>
    {% if roadmap %}
        <nav class="workspace-tabs" aria-label="Format de la feuille de route">
            {% for value, label in {
                pdf: 'Importer un PDF',
                lien: 'Ajouter un lien'
            } %}
                <a
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: band.id,
                            source: value,
                            concert: concertContext.id,
                            usage: 'roadmap'
                        }
                    )
                    }}"
                    aria-current="{{ source.value == value ? 'page' : 'false' }}"
                >
                    {{ label }}
                </a>
            {% endfor %}
        </nav>
        <p class="field-hint">
            Le concert et la catégorie sont déjà renseignés. Le document sera partagé avec toute
            l’équipe.
        </p>
    {% endif %}
    <section class="form-panel collaboration-form" aria-label="Ajouter un document">
        {{
            form_start(
                form,
                {
                    attr: {
                        class: 'patch-form',
                        novalidate: 'novalidate'
                    }
                }
            )
        }}
        {% if form.vars.errors|length %}
            <div class="form-error-summary" role="alert">
                {{ form_errors(form) }}
            </div>
        {% endif %}
        {% if form.category is defined %}
            <div class="form-grid">
                {% for field in [form.title, form.category] %}
                    {{
                        include(
                            'concert/_field.html.twig',
                            {
                                field: field
                            },
                            with_context: false
                        )
                    }}
                {% endfor %}
            </div>
        {% else %}
            {{
                include(
                    'concert/_field.html.twig',
                    {
                        field: form.title
                    },
                    with_context: false
                )
            }}
        {% endif %}
        {{
            include(
                'concert/_field.html.twig',
                {
                    field: source.value == 'pdf' ? form.file : form.url
                },
                with_context: false
            )
        }}
        {% if form.concert is defined %}
            {{
                include(
                    'concert/_field.html.twig',
                    {
                        field: form.concert
                    },
                    with_context: false
                )
            }}
        {% endif %}
        {{
            include(
                'concert/_field.html.twig',
                {
                    field: form.description
                },
                with_context: false
            )
        }}
        <div class="form-actions">
            <button class="button button-primary" type="submit">Partager avec l’équipe</button>
            <a class="cancel-link" href="{{ returnUrl }}">Annuler</a>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
