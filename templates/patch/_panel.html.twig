{% set canEdit = is_granted('SHEET_EDIT', sheet) %}
{% set canDelete = is_granted('SHEET_DELETE', sheet) %}
{% set embedded = embedded|default(false) %}
{% set panelContent %}
    {% if embedded %}
        {% if canDelete %}
            <div class="panel-header">
                <a
                    class="trash-link"
                    href="{{
                    path(
                        'app_patch_trash',
                        {
                            id: sheet.id
                        }
                    )
                    }}"
                >
                    Corbeille
                </a>
            </div>
        {% endif %}
    {% else %}
        <div class="panel-header">
            <div>
                <p class="eyebrow">
                    {{ panelLabel }}
                </p>
                <h2 id="patch-title">Patch des entrées</h2>
                {% if canDelete %}
                    <a
                        class="trash-link"
                        href="{{
                        path(
                            'app_patch_trash',
                            {
                                id: sheet.id
                            }
                        )
                        }}"
                    >
                        Corbeille
                    </a>
                {% endif %}
            </div>
            <div class="patch-stats" aria-label="Résumé du patch">
                <div>
                    <strong>{{ lines|length }}</strong>
                    <span>{{ (lines|length) == 1 ? 'canal' : 'canaux' }}</span>
                </div>
                {% if sectionCount is defined %}
                    <span class="stat-divider" aria-hidden="true"></span>
                    <div>
                        <strong>{{ sectionCount }}</strong>
                        <span>{{ sectionCount == 1 ? 'famille' : 'familles' }}</span>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if lines is empty %}
        <div class="empty-state">
            <span class="empty-channel" aria-hidden="true">01</span>
            <h3>Le premier canal vous attend.</h3>
            <p>
                Ajoutez une source pour compléter ce patch.
            </p>
            {% if canEdit %}
                <a class="button button-primary" href="{{ newSourceUrl }}">Ajouter une source</a>
            {% endif %}
        </div>
    {% else %}
        {% if sheet.band.technicalIdentity.style or sheet.band.technicalIdentity.description %}
            {{
                include(
                    'technical/_style.html.twig',
                    {
                        identity: sheet.band.technicalIdentity
                    },
                    with_context: false
                )
            }}
        {% endif %}
        <div data-patch-workspace>
            {% set families = {} %}
            {% for line in lines %}
                {% set families =
                    families|merge({
                        (line.section): true
                    })
                %}
            {% endfor %}
            {{
                include(
                    'technical/_legend.html.twig',
                    {
                        families: families
                    },
                    with_context: false
                )
            }}
            <div
                class="patch-sort"
                data-patch-sort-controls
                hidden
                role="group"
                aria-label="Ordre du patch"
            >
                <button type="button" data-patch-sort="channel" aria-pressed="true">
                    Par canal
                </button>
                <button type="button" data-patch-sort="family" aria-pressed="false">
                    Par famille
                </button>
            </div>
            <div class="table-frame">
                <table class="patch-table patch-table--compact" lang="en">
                    <caption class="visually-hidden">
                        Input list · {{ sheet.bandName }} · Channel order
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col" class="channel-column">CH</th>
                            <th scope="col">SOURCE</th>
                            <th scope="col">MIC / DI</th>
                            <th scope="col" class="stand-column">STAND</th>
                            <th scope="col" class="action-column">
                                <span class="visually-hidden">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in lines %}
                            <tr
                                data-section="{{ line.section }}"
                                data-technical-family="{{ technical_family(line.section) }}"
                                data-channel="{{ line.channelNumber }}"
                                class="{{
                                loop.first or line.section != lines[loop.index0 - 1].section
                                    ? 'is-family-start'
                                    : ''
                                }}"
                            >
                                <td class="channel-cell" data-label="CH">
                                    <span class="channel-number">
                                        {{ '%02d'|format(line.channelNumber) }}
                                    </span>
                                </td>
                                <th scope="row" class="source-cell">
                                    <span class="patch-family-name">
                                        {{
                                            technical_palette()[technical_family(
                                                line.section
                                            )].label
                                        }}
                                    </span>
                                    <span class="source-name">{{ line.sourceName }}</span>
                                    {% if line.notes and (line.notes|length) > 40 %}
                                        <details class="patch-note" lang="fr">
                                            <summary
                                                class="patch-action"
                                                title="Note du canal {{ line.channelNumber }}"
                                                aria-label="Note du canal {{
                                                line.channelNumber
                                                }}, {{ line.sourceName }}"
                                            >
                                                {{
                                                    include(
                                                        'patch/_action_icon.html.twig',
                                                        {
                                                            icon: 'note'
                                                        },
                                                        with_context: false
                                                    )
                                                }}
                                            </summary>
                                            <div lang="en">
                                                {{ line.notes|nl2br }}
                                            </div>
                                        </details>
                                    {% endif %}
                                </th>
                                <td class="microphone-cell" data-label="MIC / DI">
                                    <span>{{ line.preferredMicrophone ? : '—' }}</span>
                                    {% if line.notes and (line.notes|length) <= 40 %}
                                        <span class="patch-short-note">{{ line.notes }}</span>
                                    {% endif %}
                                    <span class="patch-mobile-stand">
                                        · {{ line.stand ? : '—' }}
                                    </span>
                                </td>
                                <td class="stand-cell" data-label="STAND">
                                    {{ line.stand ? : '—' }}
                                </td>
                                <td class="row-action" lang="fr">
                                    <div class="patch-actions">
                                        {% if canEdit %}
                                            <a
                                                class="patch-action"
                                                href="{{
                                                path(
                                                    'app_patch_edit',
                                                    {
                                                        id: line.id
                                                    }
                                                )
                                                }}"
                                                title="Modifier le canal {{ line.channelNumber }}"
                                                aria-label="Modifier le canal {{
                                                line.channelNumber
                                                }}, {{ line.sourceName }}"
                                            >
                                                {{
                                                    include(
                                                        'patch/_action_icon.html.twig',
                                                        {
                                                            icon: 'edit'
                                                        },
                                                        with_context: false
                                                    )
                                                }}
                                            </a>
                                        {% endif %}
                                        {% if canDelete %}
                                            <form
                                                class="inline-form delete-source"
                                                action="{{
                                                path(
                                                    'app_patch_delete',
                                                    {
                                                        id: line.id
                                                    }
                                                )
                                                }}"
                                                method="post"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{
                                                    csrf_token(
                                                        'patch_delete_' ~ line.id
                                                    )
                                                    }}"
                                                />
                                                <button
                                                    class="patch-action patch-action--delete"
                                                    type="submit"
                                                    title="Supprimer le canal {{
                                                    line.channelNumber
                                                    }}"
                                                    aria-label="Supprimer le canal {{
                                                    line.channelNumber
                                                    }}, {{ line.sourceName }}"
                                                >
                                                    {{
                                                        include(
                                                            'patch/_action_icon.html.twig',
                                                            {
                                                                icon: 'delete'
                                                            },
                                                            with_context: false
                                                        )
                                                    }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel-footer">
            <span class="small-dot" aria-hidden="true"></span>Les microphones et pieds indiqués sont
            les préférences du groupe.
        </div>
    {% endif %}
{% endset %}
{% if embedded %}
    <div class="patch-panel">
        {{ panelContent }}
    </div>
{% else %}
    <section class="patch-panel" aria-labelledby="patch-title">
        {{ panelContent }}
    </section>
{% endif %}
