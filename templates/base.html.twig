<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#152b38" />
        <title>
            {% block title %}
                {{ app_name }} — Fiche technique
            {% endblock %}
        </title>
        <link rel="stylesheet" href="/styles/app.css" />
        <link rel="stylesheet" href="/styles/responsive.css" />
        <script src="/scripts/stage-viewer.js" defer></script>
        <script src="/scripts/navigation.js" defer></script>
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        <header class="site-header">
            <div class="header-inner">
                <a
                    class="brand"
                    href="{{ path('app_patch_index') }}"
                    aria-label="{{ app_name }}, accueil"
                >
                    {{ include('branding/_mark.html.twig', {}, with_context: false) }}
                    <span>{{ app_name }}<span class="brand-caption">DOSSIER TECHNIQUE</span></span>
                </a>
                {% if app.user %}
                    {% set currentBand =
                        member_band(
                            concert is defined and concert
                                ? concert.band
                                : sheet is defined ? sheet.band : band|default(null)
                        )
                    %}
                    {% set currentRole =
                        band_role(
                            concert is defined and concert
                                ? concert.band
                                : sheet is defined ? sheet.band : null
                        )
                    %}
                    <button
                        type="button"
                        class="nav-toggle"
                        data-navigation-toggle
                        aria-controls="primary-navigation"
                        aria-expanded="false"
                        hidden
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                        >
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <span data-navigation-label>Menu</span>
                    </button>
                    <nav
                        id="primary-navigation"
                        class="site-nav"
                        aria-label="Navigation principale"
                    >
                        <a
                            href="{{ path('app_patch_index') }}"
                            aria-current="{{
                            app.request.attributes.get('_route') starts with 'app_patch_'
                                and (sheet is not defined or sheet.concert is null)
                                ? 'page'
                                : 'false'
                            }}"
                        >
                            Fiche du groupe
                        </a>
                        <a
                            href="{{ path('app_concert_index') }}"
                            aria-current="{{
                            app.request.attributes.get('_route') starts with 'app_concert_'
                                or (sheet is defined and sheet.concert is not null)
                                ? 'page'
                                : 'false'
                            }}"
                        >
                            Concerts
                        </a>
                        {% if currentBand %}
                            <a
                                href="{{
                                path(
                                    'app_profile_team',
                                    {
                                        id: currentBand.id
                                    }
                                )
                                }}"
                                aria-current="{{
                                app.request.attributes.get('_route') starts with 'app_profile_'
                                    ? 'page'
                                    : 'false'
                                }}"
                            >
                                Équipe & liens
                            </a>
                            {% if is_granted('BAND_TREASURY', currentBand) %}
                                <a
                                    href="{{
                                    path(
                                        'app_treasury_index',
                                        {
                                            id: currentBand.id
                                        }
                                    )
                                    }}"
                                    aria-current="{{
                                    app.request.attributes.get('_route') starts with 'app_treasury_'
                                        or app.request.attributes.get('_route')
                                            starts with 'app_stock_'
                                        ? 'page'
                                        : 'false'
                                    }}"
                                >
                                    Trésorerie & stock
                                </a>
                            {% endif %}
                        {% endif %}
                        <span class="session-info">
                            <a
                                class="session-name"
                                href="{{ path('app_account_password') }}"
                                title="Changer mon mot de passe"
                            >
                                {{ app.user.displayName }}
                            </a>
                            {% if currentRole %}
                                <span class="role-badge">{{ currentRole.label }}</span>
                            {% endif %}
                        </span>
                        <form action="{{ path('app_logout') }}" method="post" class="logout-form">
                            <input
                                type="hidden"
                                name="_csrf_token"
                                value="{{ csrf_token('logout') }}"
                            />
                            <button type="submit">Se déconnecter</button>
                        </form>
                    </nav>
                {% endif %}
            </div>
        </header>

        <main id="contenu" class="page-shell">
            {% if app_demo_mode %}
                <p class="demo-banner">
                    Démonstration privée · Les comptes, stocks et montants sont fictifs.
                </p>
            {% endif %}
            {% for message in app.flashes('success') %}
                <div class="flash flash-success" role="status">
                    <span class="flash-mark" aria-hidden="true">✓</span>{{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash flash-error" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
            {% for removed in app.flashes('patch_removed') %}
                <div class="flash" role="status">
                    <span>{{ removed.name }} a été retirée du patch.</span>
                    <form
                        action="{{
                        path(
                            'app_patch_restore',
                            {
                                id: removed.id
                            }
                        )
                        }}"
                        method="post"
                        class="inline-form"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('patch_restore_' ~ removed.id) }}"
                        />
                        <button class="text-button" type="submit">Annuler</button>
                    </form>
                </div>
            {% endfor %}
            {% block body %}

            {% endblock %}
        </main>

        <footer class="site-footer">
            <div class="footer-inner">
                <span>{{ app_name }}</span>
                <p>
                    Une fiche claire. Une scène bien préparée.
                </p>
            </div>
        </footer>
    </body>
</html>
