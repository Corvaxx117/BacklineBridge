<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>
            {% block title %}
                {{ app_name }} — Fiche technique
            {% endblock %}
        </title>
        {{ include('theme/_head.html.twig', {}, with_context: false) }}
        <link rel="stylesheet" href="/styles/app.css" />
        <link rel="stylesheet" href="/styles/responsive.css" />
        <link rel="stylesheet" href="/styles/navigation.css" />
        <link rel="stylesheet" href="/styles/collaboration.css" />
        <link rel="stylesheet" href="/styles/tasks.css" />
        <link rel="stylesheet" href="/styles/calendar.css" />
        <script src="/scripts/stage-viewer.js" defer></script>
        <script src="/scripts/navigation.js" defer></script>
        {% block page_assets %}

        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        <header class="site-header">
            <div class="header-inner">
                <a
                    class="brand"
                    href="{{ path('app_patch_index') }}"
                    aria-label="{{ app_name }}, accueil"
                >
                    {{ include('branding/_mark.html.twig', {}, with_context: false) }}
                    <span>{{ app_name }}<span class="brand-caption">ESPACE DU GROUPE</span></span>
                </a>
                {% if app.user %}
                    {% set currentBand =
                        member_band(
                            concert is defined and concert
                                ? concert.band
                                : sheet is defined ? sheet.band : band|default(null)
                        )
                    %}
                    {% set currentRole =
                        band_role(
                            concert is defined and concert
                                ? concert.band
                                : sheet is defined ? sheet.band : null
                        )
                    %}
                    {{
                        include(
                            'navigation/_primary.html.twig',
                            {
                                currentBand: currentBand,
                                currentRole: currentRole,
                                referenceActive: app.request.attributes.get('_route')
                                    starts with 'app_patch_'
                                    and (sheet is not defined or sheet.concert is null),
                                concertActive: app.request.attributes.get('_route')
                                    starts with 'app_concert_'
                                    or (sheet is defined and sheet.concert is not null)
                            },
                            with_context: false
                        )
                    }}
                {% endif %}
            </div>
        </header>

        <main id="contenu" class="page-shell">
            {% if app_demo_mode %}
                <p class="demo-banner">
                    Démonstration privée · Les comptes, stocks et montants sont fictifs.
                </p>
            {% endif %}
            {% for message in app.flashes('success') %}
                <div class="flash flash-success" role="status">
                    <span class="flash-mark" aria-hidden="true">✓</span>{{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash flash-error" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
            {% for removed in app.flashes('patch_removed') %}
                <div class="flash" role="status">
                    <span>{{ removed.name }} a été retirée du patch.</span>
                    <form
                        action="{{
                        path(
                            'app_patch_restore',
                            {
                                id: removed.id
                            }
                        )
                        }}"
                        method="post"
                        class="inline-form"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('patch_restore_' ~ removed.id) }}"
                        />
                        <button class="text-button" type="submit">Annuler</button>
                    </form>
                </div>
            {% endfor %}
            {% block body %}

            {% endblock %}
        </main>

        <footer class="site-footer">
            <div class="footer-inner">
                <span>{{ app_name }}</span>
                <p>
                    Une fiche claire. Une scène bien préparée.
                </p>
            </div>
        </footer>
        {{ include('theme/_switcher.html.twig', {}, with_context: false) }}
    </body>
</html>
