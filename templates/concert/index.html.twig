{% extends 'base.html.twig' %}

{% block title %}
    Concerts · {{ app_name }}
{% endblock %}

{% block page_assets %}
    <link rel="stylesheet" href="{{ asset('/styles/concerts.css') }}" />
    <link rel="stylesheet" href="{{ asset('/styles/concert-importance.css') }}" />
{% endblock %}

{% block body %}
    <div class="page-topline">
        <span class="eyebrow">Les dates du groupe</span>
        <span class="reference-tag">
            {{ concerts|length }}
            {{ (concerts|length) == 1 ? 'concert' : 'concerts' }}
        </span>
    </div>
    <section class="hero" aria-labelledby="page-title">
        <div class="hero-copy">
            {% if band_role() and band_role().value == 'booker' %}
                <p class="eyebrow">
                    Tournée et conditions d’accueil
                </p>
            {% endif %}
            <h1 id="page-title">Concerts<span class="title-period">.</span></h1>
            <p class="hero-description">
                Une date, une salle, un patch à préparer.<br />Chaque concert possède son propre
                dossier technique.
            </p>
        </div>
        {% if canCreate %}
            <div class="hero-actions">
                {% if band %}
                    <details class="concert-import-menu">
                        <summary class="button button-secondary">
                            Importer des concerts <span aria-hidden="true">⌄</span>
                        </summary>
                        <div>
                            <a
                                href="{{
                                path(
                                    'app_concert_orfeo_prepare',
                                    {
                                        id: band.id
                                    }
                                )
                                }}"
                            >
                                Depuis Orfeo
                            </a>
                            <a
                                href="{{
                                path(
                                    'app_concert_bandsintown_prepare',
                                    {
                                        id: band.id
                                    }
                                )
                                }}"
                            >
                                Depuis Bandsintown
                            </a>
                        </div>
                    </details>
                {% endif %}
                <a class="button button-primary hero-action" href="{{ path('app_concert_new') }}">
                    <span class="button-plus" aria-hidden="true">+</span>Créer un concert
                </a>
            </div>
        {% endif %}
    </section>

    {{
        include(
            'concert/_filters.html.twig',
            {
                filters: filters,
                importanceLevels: importanceLevels
            },
            with_context: false
        )
    }}
    {% if concerts is empty and not filters.filtered %}
        <section class="patch-panel empty-state" aria-labelledby="empty-title">
            <span class="empty-channel" aria-hidden="true">01</span>
            <h2 id="empty-title">Votre première date vous attend.</h2>
            <p>
                {{ canCreate
                    ? 'Partez de la fiche du groupe pour préparer le prochain concert.'
                    : 'Les concerts des groupes auxquels vous avez accès apparaîtront ici.' }}
            </p>
            {% if canCreate %}
                <a class="button button-primary" href="{{ path('app_concert_new') }}">
                    Créer un concert
                </a>
            {% endif %}
        </section>
    {% else %}
        {% if concerts is empty and filters.filtered %}
            <p class="concert-group-empty">
                Aucun concert pour ce niveau d’enjeu. <a
                    href="{{
                    path(
                        'app_concert_index',
                        {
                            sort: filters.sort
                        }
                    )
                    }}"
                >
                    Afficher tous les niveaux
                </a>
            </p>
        {% endif %}
        <section class="concert-group" aria-labelledby="upcoming-concerts-title">
            <div class="concert-group-heading">
                <h2 id="upcoming-concerts-title">Concerts à venir</h2>
                <span class="reference-tag">{{ upcomingConcerts|length }}</span>
            </div>
            {% if upcomingConcerts is empty %}
                <p class="concert-group-empty">
                    Aucun concert à venir pour le moment.
                </p>
            {% else %}
                <ol
                    class="concert-list"
                    aria-label="{{
                    filters.sort == 'importance'
                        ? 'Concerts à venir, par enjeu décroissant'
                        : 'Concerts à venir, du plus proche au plus lointain'
                    }}"
                >
                    {% for concert in upcomingConcerts %}
                        {{
                            include(
                                'concert/_card.html.twig',
                                {
                                    concert: concert,
                                    past: false,
                                    filters: filters,
                                    importanceLevels: importanceLevels
                                },
                                with_context: false
                            )
                        }}
                    {% endfor %}
                </ol>
            {% endif %}
        </section>
        {% if pastConcerts is not empty %}
            <section class="concert-group concert-history" aria-labelledby="past-concerts-title">
                <div class="concert-group-heading">
                    <h2 id="past-concerts-title">Concerts passés</h2>
                    <span class="reference-tag">{{ pastConcerts|length }}</span>
                </div>
                <ol
                    class="concert-list"
                    aria-label="{{
                    filters.sort == 'importance'
                        ? 'Concerts passés, par enjeu décroissant'
                        : 'Concerts passés, du plus récent au plus ancien'
                    }}"
                >
                    {% for concert in pastConcerts %}
                        {{
                            include(
                                'concert/_card.html.twig',
                                {
                                    concert: concert,
                                    past: true,
                                    filters: filters,
                                    importanceLevels: importanceLevels
                                },
                                with_context: false
                            )
                        }}
                    {% endfor %}
                </ol>
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
