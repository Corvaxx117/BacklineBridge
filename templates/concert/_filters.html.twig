<div class="concert-filter-bar">
    <form
        class="concert-search"
        method="get"
        action="{{ path('app_concert_index') }}"
        role="search"
        aria-label="Rechercher un concert"
    >
        <label class="visually-hidden" for="concert-search">Rechercher un concert</label>
        <input
            type="search"
            id="concert-search"
            name="q"
            value="{{ filters.search }}"
            maxlength="160"
            placeholder="Salle, ville ou notes…"
        />
        <input type="hidden" name="sort" value="{{ filters.sort }}" />
        <button type="submit" aria-label="Rechercher" title="Rechercher">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
            >
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="m16 16 4.5 4.5" />
            </svg>
        </button>
        {% if filters.filtered %}
            <a
                class="concert-search-clear"
                href="{{
                path(
                    'app_concert_index',
                    {
                        sort: filters.sort
                    }
                )
                }}"
                aria-label="Effacer la recherche"
                title="Effacer la recherche"
            >
                <span aria-hidden="true">×</span>
            </a>
        {% endif %}
    </form>
    <nav class="concert-sort-links" aria-label="Trier les concerts">
        <a
            href="{{
            path(
                'app_concert_index',
                {
                    sort: 'date',
                    q: filters.search
                }
            )
            }}"
            class="{{ filters.sort == 'date' ? 'is-active' : '' }}"
            {{ filters.sort == 'date' ? 'aria-current="page"' : '' }}
        >
            Par date
        </a>
        <a
            href="{{
            path(
                'app_concert_index',
                {
                    sort: 'importance',
                    q: filters.search
                }
            )
            }}"
            class="{{ filters.sort == 'importance' ? 'is-active' : '' }}"
            {{ filters.sort == 'importance' ? 'aria-current="page"' : '' }}
        >
            Enjeu le plus fort
        </a>
    </nav>
</div>
