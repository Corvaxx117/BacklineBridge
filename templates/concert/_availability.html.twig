<section class="availability-panel" id="disponibilites" aria-labelledby="availability-title">
    <div class="panel-header">
        <div>
            <p class="eyebrow">
                L’équipe pour cette date
            </p>
            <h2 id="availability-title">Qui est disponible ?</h2>
        </div>
        <span class="availability-counter">
            {{ availability.counts.available }} / {{ availability.total }} disponibles
        </span>
    </div>
    {% if availability.counts.unavailable %}
        <p class="availability-alert">
            Date à discuter : {{ availability.counts.unavailable }} {{ availability.counts.unavailable
                == 1
                ? 'personne indisponible'
                : 'personnes indisponibles' }}.
        </p>
    {% elseif availability.total and availability.counts.pending == 0 %}
        <p class="availability-complete">
            Tous les responsables inscrits ont confirmé leur disponibilité.
        </p>
    {% endif %}
    <ul class="availability-roster">
        {% for person in availability.rows %}
            <li class="availability-person">
                <div>
                    <strong>
                        {{ person.user.displayName }}{% if person.mine %}
                            <span class="availability-you">(moi)</span>
                        {% endif %}
                    </strong>
                    {% if person.comment %}
                        <p>
                            {{ person.comment|nl2br }}
                        </p>
                    {% endif %}
                    {% if person.answeredAt %}
                        <small>Réponse du {{ person.answeredAt|date('d/m/Y à H:i') }}</small>
                    {% endif %}
                </div>
                <span class="availability-badge availability-{{ person.status.value }}">
                    {{ person.status.label }}
                </span>
            </li>
        {% else %}
            <li class="availability-person">Aucun responsable dans ce groupe pour le moment.</li>
        {% endfor %}
    </ul>
    {% if availabilityForm %}
        <div class="availability-response">
            {{
                include(
                    'concert/_availability_form.html.twig',
                    {
                        concert: concert,
                        availabilityForm: availabilityForm
                    },
                    with_context: false
                )
            }}
        </div>
    {% endif %}
    <p class="panel-footer">
        Chaque responsable répond pour lui-même, ingé son compris. Ces réponses concernent le {{
            concert.date|date('d/m/Y')
        }} ; elles restent distinctes du statut du concert et des confirmations de la salle. L’équipe
        affichée correspond aux responsables disposant d’un compte.
    </p>
</section>
