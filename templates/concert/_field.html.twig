<div class="field">
    {{ form_label(field) }}
    {{
        form_widget(
            field,
            {
                attr: {
                    'aria-describedby': field.vars.id ~ '_errors'
                        ~ (field.vars.help ? ' ' ~ field.vars.id ~ '_help' : '')
                }
            }
        )
    }}
    {{
        form_help(
            field,
            {
                help_attr: {
                    class: 'field-help'
                }
            }
        )
    }}
    <div class="field-errors" id="{{ field.vars.id }}_errors">
        {{ form_errors(field) }}
    </div>
</div>
