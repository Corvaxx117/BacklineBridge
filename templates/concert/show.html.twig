{% extends 'base.html.twig' %}

{% block title %}
    {{ concert.venue }} — {{ concert.date|date('d/m/Y') }} · {{ app_name }}
{% endblock %}

{% block page_assets %}
    <link rel="stylesheet" href="/styles/concert-detail.css" />
    <script src="/scripts/concert-details.js" defer></script>
{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_concert_index') }}">
        <span aria-hidden="true">←</span>Revenir aux concerts
    </a>
    <section class="hero concert-hero" aria-labelledby="page-title">
        <div class="hero-copy">
            <p class="eyebrow">
                {{ sheet.bandName }} / Dossier du concert
            </p>
            <p class="concert-creator">
                {% if concert.createdByName %}
                    Créé par <strong>{{ concert.createdByName }}</strong>{% if concert.createdAt %}
                        · {{ concert.createdAt|date('d/m/Y') }}
                    {% endif %}
                {% else %}
                    Créateur non renseigné pour ce concert existant
                {% endif %}
            </p>
            <h1 id="page-title">{{ concert.venue }}<span class="title-period">.</span></h1>
            <p class="hero-description">
                <time datetime="{{ concert.date|date('Y-m-d') }}">
                    {{ concert.date|date('d/m/Y') }}
                </time>{% if concert.startTime %}
                    à {{ concert.startTime }}
                {% endif %}· {{ concert.city }}
                <span class="status-badge status-{{ concert.status.value }}">
                    {{ concert.status.label }}
                </span>
            </p>
        </div>
        {% if is_granted('CONCERT_UPDATE', concert) %}
            <a
                class="button button-secondary hero-action"
                href="{{
                path(
                    'app_concert_edit',
                    {
                        id: concert.id
                    }
                )
                }}"
            >
                Modifier le concert
            </a>
        {% endif %}
    </section>
    {{
        include(
            'concert/_availability.html.twig',
            {
                concert: concert,
                availability: availability,
                availabilityForm: availabilityForm
            },
            with_context: false
        )
    }}
    {% if concert.notes %}
        <section class="concert-notes" aria-labelledby="concert-notes-title">
            <div class="concert-notes-heading">
                <h2 id="concert-notes-title">Notes</h2>
                {% if is_granted('CONCERT_UPDATE', concert) %}
                    <a
                        class="edit-link"
                        href="{{
                        path(
                            'app_concert_edit',
                            {
                                id: concert.id
                            }
                        )
                        }}#concert_notes"
                    >
                        Modifier les notes
                    </a>
                {% endif %}
            </div>
            <p class="concert-notes-content">
                {{ concert.notes|nl2br }}
            </p>
        </section>
    {% endif %}
    {{
        include(
            'concert/document/_panel.html.twig',
            {
                concert: concert,
                documents: documents
            },
            with_context: false
        )
    }}
    {{
        include(
            'concert/contact/_panel.html.twig',
            {
                concert: concert,
                contacts: contacts
            },
            with_context: false
        )
    }}
    {% if canViewConditions %}
        {{
            include(
                'concert/_conditions.html.twig',
                {
                    concert: concert,
                    conditions: conditions
                },
                with_context: false
            )
        }}
    {% endif %}
    <details
        id="dossier-technique"
        class="technical-dossier concert-disclosure"
        data-concert-section
    >
        {{
            include(
                'concert/_section_summary.html.twig',
                {
                    title: 'Dossier technique',
                    titleId: 'technical-dossier-title',
                    meta: (lines|length) ~ ' sources · plan et matériel'
                },
                with_context: false
            )
        }}
        <nav class="concert-tools" aria-label="Préparation avec la salle">
            <a
                class="button button-secondary"
                href="{{
                path(
                    'app_sheet_pdf',
                    {
                        id: sheet.id
                    }
                )
                }}"
            >
                Télécharger la fiche PDF
            </a>
            <a
                class="button button-secondary"
                href="{{
                path(
                    'app_concert_responses',
                    {
                        id: concert.id
                    }
                )
                }}"
            >
                Réponses de la salle
            </a>
            {% if is_granted('CONCERT_SHARE', concert) %}
                <a
                    class="button button-primary"
                    href="{{
                    path(
                        'app_concert_invitations',
                        {
                            id: concert.id
                        }
                    )
                    }}"
                >
                    Inviter la salle
                </a>
            {% endif %}
        </nav>

        <div class="technical-heading">
            <p>
                Le patch peut être adapté pour cette date, indépendamment de la fiche du groupe.
            </p>
            {% if is_granted('CONCERT_IMPORT_REFERENCE', concert) %}
                <a
                    class="button button-secondary"
                    href="{{
                    path(
                        'app_concert_reference_import',
                        {
                            id: concert.id
                        }
                    )
                    }}"
                >
                    Récupérer la référence
                </a>
            {% endif %}
            {% if is_granted('CONCERT_EDIT', concert) %}
                <a
                    class="button button-primary"
                    href="{{
                    path(
                        'app_concert_patch_new',
                        {
                            id: concert.id
                        }
                    )
                    }}"
                >
                    Ajouter une source
                </a>
            {% endif %}
        </div>
        {{
            include(
                'stage/_panel.html.twig',
                {
                    sheet: sheet
                },
                with_context: false
            )
        }}
        {{
            include(
                'patch/_panel.html.twig',
                {
                    sheet: sheet,
                    lines: lines,
                    panelLabel: 'Patch de ce concert',
                    newSourceUrl: path(
                        'app_concert_patch_new',
                        {
                            id: concert.id
                        }
                    )
                },
                with_context: false
            )
        }}
        {{
            include(
                'equipment/_panel.html.twig',
                {
                    sheet: sheet
                },
                with_context: false
            )
        }}
        {{
            include(
                'patch/_notices.html.twig',
                {
                    sheet: sheet
                },
                with_context: false
            )
        }}
    </details>
    {% if is_granted('BAND_CALENDAR', concert.band) %}
        <details id="concert-calendar-section" class="concert-disclosure" data-concert-section>
            {{
                include(
                    'concert/_section_summary.html.twig',
                    {
                        title: 'Google Agenda',
                        titleId: 'concert-calendar-section-title',
                        meta: calendarName
                    },
                    with_context: false
                )
            }}
            {{ include('concert/calendar/_panel.html.twig') }}
        </details>
    {% endif %}
    {% if bandsintownSource %}
        <details id="concert-bandsintown" class="concert-disclosure" data-concert-section>
            {{
                include(
                    'concert/_section_summary.html.twig',
                    {
                        title: 'Annonce Bandsintown',
                        titleId: 'concert-bandsintown-title',
                        meta: 'Adresse et billetterie'
                    },
                    with_context: false
                )
            }}
            {{ include('concert/import/bandsintown/_source.html.twig') }}
        </details>
    {% endif %}
    {% if is_granted('CONCERT_DELETE', concert) %}
        <div class="concert-management">
            <p>
                Gestion du concert
            </p>
            <a
                class="danger-link"
                href="{{
                path(
                    'app_concert_delete',
                    {
                        id: concert.id
                    }
                )
                }}"
            >
                Supprimer le concert
            </a>
        </div>
    {% endif %}
{% endblock %}
