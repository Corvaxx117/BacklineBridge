{% extends 'base.html.twig' %}
{% block title %}
    Conditions du concert · {{ app_name }}
{% endblock %}
{% block page_assets %}
    <link rel="stylesheet" href="{{ asset('/styles/conditions.css') }}" />
    <script src="{{ asset('/scripts/conditions-editor.js') }}" defer></script>
{% endblock %}
{% block body %}
    <a
        class="back-link"
        href="{{
        path(
            'app_concert_show',
            {
                id: concert.id,
                _fragment: 'concert-conditions'
            }
        )
        }}"
    >
        ← Revenir au concert
    </a>
    <section class="form-heading">
        <p class="eyebrow">
            {{ concert.venue }} · {{ concert.date|date('d/m/Y') }}
        </p>
        <h1>Conditions du concert<span class="title-period">.</span></h1>
        <p>
            Accueil, rémunération et précisions utiles, au même endroit.
        </p>
    </section>
    <section class="form-panel conditions-editor">
        {{
            form_start(
                form,
                {
                    attr: {
                        class: 'patch-form concert-form',
                        novalidate: 'novalidate',
                        'data-conditions-editor': ''
                    }
                }
            )
        }}
        {% if form.vars.submitted and not form.vars.valid %}
            <div class="form-error-summary" role="alert">
                <strong>Les conditions n’ont pas été enregistrées.</strong>
                {{ form_errors(form) }}
                <a
                    href="{{
                    path(
                        'app_concert_conditions',
                        {
                            id: concert.id
                        }
                    )
                    }}"
                >
                    Recharger la version actuelle
                </a>
            </div>
        {% endif %}
        {% if orfeoSource %}
            {{
                include(
                    'concert/import/orfeo/_conditions_proposals.html.twig',
                    {
                        source: orfeoSource,
                        concert: concert,
                        form: form
                    },
                    with_context: false
                )
            }}
        {% endif %}
        <div class="conditions-copy-feedback" hidden data-conditions-feedback>
            <p role="status" aria-live="polite" data-conditions-status></p>
            <button class="text-button" type="button" data-conditions-cancel hidden>
                Annuler le remplacement
            </button>
        </div>
        <fieldset class="conditions-form-section">
            <legend>
                Accueil et déplacements
            </legend>
            <div class="form-grid">
                {% for field in [
                    form.accommodation,
                    form.transportCoverage,
                    form.accommodationNotes,
                    form.transportNotes
                ] %}
                    {{
                        include(
                            'concert/_field.html.twig',
                            {
                                field: field
                            },
                            with_context: false
                        )
                    }}
                {% endfor %}
            </div>
            {{
                include(
                    'concert/_field.html.twig',
                    {
                        field: form.mealNotes
                    },
                    with_context: false
                )
            }}
        </fieldset>
        <fieldset class="conditions-form-section">
            <legend>
                Rémunération
            </legend>
            <div class="form-grid">
                {% for field in [
                    form.feeAmount,
                    form.feeBasis,
                    form.paymentFramework,
                    form.paymentMethod
                ] %}
                    {{
                        include(
                            'concert/_field.html.twig',
                            {
                                field: field
                            },
                            with_context: false
                        )
                    }}
                {% endfor %}
            </div>
            <details
                class="conditions-engineer-editor"
                {{
                not form.engineerPresence.vars.valid
                    or not form.engineerPayment.vars.valid
                    or not form.engineerPaymentFramework.vars.valid
                    or not form.engineerFeeAmount.vars.valid
                    ? 'open'
                    : ''
                }}
            >
                <summary>
                    Présence et rémunération de l’ingé son
                </summary>
                <div class="form-grid">
                    {% for field in [
                        form.engineerPresence,
                        form.engineerPayment,
                        form.engineerPaymentFramework,
                        form.engineerFeeAmount
                    ] %}
                        {{
                            include(
                                'concert/_field.html.twig',
                                {
                                    field: field
                                },
                                with_context: false
                            )
                        }}
                    {% endfor %}
                </div>
            </details>
        </fieldset>
        <fieldset class="conditions-form-section">
            <legend>
                Précisions
            </legend>
            {{
                include(
                    'concert/_field.html.twig',
                    {
                        field: form.notes
                    },
                    with_context: false
                )
            }}
        </fieldset>
        <div class="form-actions">
            <button class="button button-primary" type="submit">Enregistrer les conditions</button>
            <a
                class="cancel-link"
                href="{{
                path(
                    'app_concert_show',
                    {
                        id: concert.id,
                        _fragment: 'concert-conditions'
                    }
                )
                }}"
            >
                Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
