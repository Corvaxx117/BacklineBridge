<section
    id="concert-documents"
    class="collaboration-panel"
    aria-labelledby="concert-documents-title"
>
    <div class="panel-header">
        <div>
            <p class="eyebrow">
                Fiche de la salle, accès, contrat…
            </p>
            <h2 id="concert-documents-title">Documents du concert</h2>
        </div>
        {% if is_granted('BAND_COLLABORATE', concert.band) %}
            <div class="collaboration-actions">
                <a
                    class="button button-secondary"
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: concert.band.id,
                            source: 'pdf',
                            concert: concert.id
                        }
                    )
                    }}"
                >
                    Ajouter un PDF
                </a>
                <a
                    class="button button-secondary"
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: concert.band.id,
                            source: 'lien',
                            concert: concert.id
                        }
                    )
                    }}"
                >
                    Ajouter un lien
                </a>
            </div>
        {% endif %}
    </div>
    {% if documents is empty %}
        <p class="collaboration-empty">
            Ajoute un PDF ou le lien d’un document partagé. Toute l’équipe le retrouvera ici et dans
            l’onglet Documents.
        </p>
    {% else %}
        {{
            include(
                'document/_cards.html.twig',
                {
                    documents: documents,
                    showConcert: false
                },
                with_context: false
            )
        }}
    {% endif %}
</section>
