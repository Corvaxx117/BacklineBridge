<details
    id="concert-documents"
    class="collaboration-panel concert-disclosure"
    aria-labelledby="concert-documents-title"
    data-concert-section
>
    {{
        include(
            'concert/_section_summary.html.twig',
            {
                title: 'Documents du concert',
                titleId: 'concert-documents-title',
                meta: documents|length
                    ? (documents|length) ~ ((documents|length) == 1 ? ' document' : ' documents')
                    : 'Aucun document'
            },
            with_context: false
        )
    }}
    {% if is_granted('BAND_COLLABORATE', concert.band) %}
        <div class="panel-header">
            <div class="collaboration-actions">
                <a
                    class="button button-primary"
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: concert.band.id,
                            source: 'pdf',
                            concert: concert.id,
                            usage: 'roadmap'
                        }
                    )
                    }}"
                >
                    Ajouter la feuille de route
                </a>
                <a
                    class="button button-secondary"
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: concert.band.id,
                            source: 'pdf',
                            concert: concert.id
                        }
                    )
                    }}"
                >
                    Ajouter un PDF
                </a>
                <a
                    class="button button-secondary"
                    href="{{
                    path(
                        'app_document_create',
                        {
                            id: concert.band.id,
                            source: 'lien',
                            concert: concert.id
                        }
                    )
                    }}"
                >
                    Ajouter un lien
                </a>
            </div>
        </div>
    {% endif %}
    {% if documents is empty %}
        <p class="collaboration-empty">
            Aucun document ajouté pour cette date.
        </p>
    {% else %}
        {{
            include(
                'document/_cards.html.twig',
                {
                    documents: documents,
                    showConcert: false
                },
                with_context: false
            )
        }}
    {% endif %}
</details>
