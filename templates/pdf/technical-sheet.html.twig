<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <title>
            Fiche technique - {{ dossier.bandName }}
        </title>
        <style>
            {{ include('pdf/styles.css.twig', {}, with_context: false) }}
            {{ technical_pdf_styles() }}
        </style>
    </head>
    <body>
        <section class="{{ dossier.stagePlan ? 'stage-page' : '' }}">
            <table class="document-header">
                <tr>
                    <td>
                        <h1>{{ dossier.bandName }}</h1>
                        <p>
                            {{ dossier.label }}{% if dossier.venue %}
                                - {{ dossier.venue }}
                            {% endif %}
                            {% if dossier.city %}
                                · {{ dossier.city }}
                            {% endif %}
                            {% if dossier.date %}
                                · {{ dossier.date|date('d/m/Y') }}
                            {% endif %}
                        </p>
                        {% if dossier.documentLabel %}
                            <p class="caption">
                                {{ dossier.documentLabel }}
                            </p>
                        {% endif %}
                        {% if dossier.publishedAt %}
                            <p class="caption">
                                Publication du {{ dossier.publishedAt|date('d/m/Y à H:i') }} - version
                                transmise à la salle
                            </p>
                        {% endif %}
                    </td>
                    <td class="document-contacts">
                        <p class="document-kind">
                            FICHE TECHNIQUE
                        </p>
                        {% if dossier.identity and dossier.identity.contacts %}
                            <table class="public-contacts">
                                {% for row in dossier.identity.contacts|batch(2) %}
                                    <tr>
                                        {% for contact in row %}
                                            <td>
                                                <span class="caption">{{ contact.role }}</span><br
                                                />
                                                <strong>{{ contact.name }}</strong>{% if
                                                    contact.phone %}
                                                    <br />{{ contact.phone }}
                                                {% endif %}
                                                {% if contact.email %}
                                                    <br /><a href="mailto:{{ contact.email }}">{{
                                                            contact.email
                                                        }}</a>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </table>
                        {% endif %}
                    </td>
                </tr>
            </table>
            <h2>Plan de scène</h2>
            {% if dossier.stagePlan %}
                <div class="stage-image-container">
                    <img
                        class="stage-image"
                        style="width: {{ stageWidth }}pt; height: {{ stageHeight }}pt;"
                        src="{{ stageImage }}"
                        alt="Plan de scène de {{ dossier.bandName }}"
                    />
                </div>
                <p class="stage-caption">
                    Vue depuis le public. Les orientations et tailles correspondent au plan
                    enregistré. Les précisions complètes des repères figurent en fin de document.
                </p>
            {% else %}
                <p class="empty-state">
                    Le plan de scène n’a pas encore été renseigné.
                </p>
            {% endif %}
        </section>
        <section>
            <h2>Patch des entrées</h2>
            {% if dossier.identity %}{{
                include(
                    'technical/_style.html.twig',
                    {
                        identity: dossier.identity
                    },
                    with_context: false
                )
            }}{% endif %}
            {% if dossier.lines %}
                {% set families = {} %}
                {% for line in dossier.lines %}
                    {% set families =
                        families|merge({
                            (technical_family(line.section|default('utility'))): true
                        })
                    %}
                {% endfor %}
                {{
                    include(
                        'technical/_legend.html.twig',
                        {
                            families: families
                        },
                        with_context: false
                    )
                }}
                <table class="data-table input-table">
                    <thead>
                        <tr>
                            <th class="channel">CH</th>
                            <th class="source">SOURCE</th>
                            <th class="microphone">MIC / DI</th>
                            <th class="stand">STAND</th>
                            <th class="other">OTHER</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in dossier.lines %}
                            {% set family = technical_family(line.section|default('utility')) %}
                            {% set firstInFamily = loop.first
                                or family
                                    != technical_family(
                                        dossier.lines[loop.index0 - 1].section|default('utility')
                                    )
                            %}
                            <tr
                                class="input-family input-family-{{ family }} {{
                                firstInFamily
                                    ? 'first-in-family'
                                    : ''
                                }}"
                            >
                                <td class="channel">{{ '%02d'|format(line.channel) }}</td>
                                <td>
                                    {% if firstInFamily %}
                                        <span class="pdf-family-name">
                                            {{ technical_palette()[family].label }} ·
                                        </span>
                                    {% endif %}{{ line.source }}
                                </td>
                                <td>{{ line.microphone ? : '-' }}</td>
                                <td>{{ line.stand ? : '-' }}</td>
                                <td>
                                    {{ line.notes and (line.notes|length) <= 40
                                        ? line.notes
                                        : line.notes ? 'See input notes' : '-' }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% set notes = {} %}
                {% for line in dossier.lines|filter(
                    line => line.notes and (line.notes|length) > 40
                ) %}
                    {% set notes =
                        notes|merge({
                            (line.notes): notes[line.notes]
                                |default([])
                                |merge(['%02d'|format(line.channel)])
                        })
                    %}
                {% endfor %}
                {% if notes %}
                    <div class="patch-notes">
                        <h3>Input notes</h3>
                        {% for text, channels in notes %}
                            <p>
                                <strong>CH {{ channels|join(', ') }} :</strong> {{ text|nl2br }}
                            </p>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <p class="empty-state">
                    Aucune source dans ce patch.
                </p>
            {% endif %}
            {% if dossier.notes %}
                <div class="practical-notes note-section">
                    <h3>Informations pratiques du concert</h3>
                    <p>
                        {{ dossier.notes|nl2br }}
                    </p>
                </div>
            {% endif %}
        </section>
        <section class="material-section">
            <h2>Matériel à prévoir</h2>
            {% set groups = {} %}
            {% for item in dossier.equipment %}
                {% set category = item.category|trim ? : 'Autre' %}
                {% set key = 'category_' ~ category %}
                {% set groups =
                    groups|merge({
                        (key): {
                            label: category,
                            items: groups[key].items|default([])|merge([item])
                        }
                    })
                %}
            {% endfor %}
            {% for group in groups %}
                <div class="equipment-group">
                    <h3>
                        {{ group.label == 'Batterie' and is_drum_kit(group.items)
                            ? 'Kit batterie complet - fûts et hardware'
                            : group.label }}
                    </h3>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="quantity">Qté</th>
                                <th class="equipment-label">Équipement</th>
                                <th class="equipment-specification">Préférences / conditions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in group.items %}
                                <tr class="equipment-family-{{ technical_equipment_family(item) }}">
                                    <td class="quantity">{{ item.quantity }}</td>
                                    <td>{{ item.label }}</td>
                                    <td>{{ item.specification ? : '-' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="empty-state">
                    Aucune demande de matériel renseignée.
                </p>
            {% endfor %}
        </section>
        {% if dossier.notices or dossier.stagePlan %}
            <section class="appendix-page">
                {% if dossier.notices %}
                    <div class="notices">
                        <h2>Notes de la fiche technique</h2>
                        {% for notice in dossier.notices %}
                            <p>
                                {{ notice|nl2br }}
                            </p>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if dossier.stagePlan %}
                    <div class="note-section">
                        <h2>Repères du plan de scène</h2>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="stage-label">Élément</th>
                                    <th class="stage-notes">Précisions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in dossier.stagePlan %}
                                    <tr>
                                        <td>{{ item.label }}</td>
                                        <td>
                                            {{ item.notes ? : '-' }}
                                            {% if item.patchLabel|default('') %}
                                                <br /><strong>{{ item.patchLabel }}</strong>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        {% endif %}
    </body>
</html>
