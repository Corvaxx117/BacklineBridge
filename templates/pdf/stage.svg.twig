<svg
    xmlns="http://www.w3.org/2000/svg"
    width="{{ width }}"
    height="{{ height }}"
    viewBox="{{ viewBox }}"
>
    <rect
        x="0"
        y="0"
        width="1000"
        height="606"
        rx="4"
        fill="#f2f5ef"
        stroke="#81948b"
        stroke-width="2"
    />
    <g stroke="#dce4d8" stroke-width="0.5">
        {% for column in 1..19 %}
            <line x1="{{ column * 50 }}" y1="0" x2="{{ column * 50 }}" y2="606" />
        {% endfor %}
        {% for row in 1..11 %}
            <line x1="0" y1="{{ row * 50 }}" x2="1000" y2="{{ row * 50 }}" />
        {% endfor %}
    </g>
    <g font-family="DejaVu Sans" text-anchor="middle">
        <text x="500" y="17" font-size="10" fill="#65796d">
            FOND DE SCÈNE
        </text>
        <text x="500" y="596" font-size="10" fill="#65796d">
            PUBLIC - AVANT-SCÈNE
        </text>
        {% for node in nodes %}
            <g
                transform="translate({{ node.x }} {{ node.y }}) rotate({{ node.rotation }}) scale({{
                node.scale
                }})"
            >
                {% if node.kind == 'riser' %}
                    <rect
                        x="{{ - node.width / 2 }}"
                        y="{{ - node.height / 2 }}"
                        width="{{ node.width }}"
                        height="{{ node.height }}"
                        rx="6"
                        fill="{{ node.fill }}"
                        stroke="{{ node.stroke }}"
                        stroke-width="1.5"
                        stroke-dasharray="5 4"
                    />
                {% elseif node.kind != 'person' %}
                    <rect
                        x="{{ - node.width / 2 }}"
                        y="{{ - node.height / 2 }}"
                        width="{{ node.width }}"
                        height="{{ node.height }}"
                        rx="6"
                        fill="{{ node.fill }}"
                        stroke="{{ node.stroke }}"
                        stroke-width="1.5"
                    />
                {% endif %}
                {% if node.kind == 'drums' %}
                    <g
                        transform="translate({{ - node.symbolWidth / 2 }} {{
                        - node.height / 2
                            + 7
                        }}) scale({{ node.symbolWidth / 260 }})"
                    >
                        {{ include('stage/_drum-kit.svg.twig', {}, with_context: false) }}
                    </g>
                {% elseif node.kind != 'riser' %}
                    <g transform="translate(-12 {{ - node.height / 2 + 7 }})">
                        {{
                            include(
                                'pdf/stage-symbol.svg.twig',
                                {
                                    kind: node.kind
                                },
                                with_context: false
                            )
                        }}
                    </g>
                {% endif %}
                {% for line in node.label %}
                    <text
                        x="0"
                        y="{{ node.labelY + loop.index0 * 17 }}"
                        font-size="14"
                        font-weight="bold"
                        fill="{{ node.kind == 'person' ? '#9f4b31' : '#152b38' }}"
                    >
                        {{ line }}
                    </text>
                {% endfor %}
                {% for line in node.notes %}
                    <text
                        x="0"
                        y="{{ node.labelY + (node.label|length) * 17 + loop.index0 * 13 }}"
                        font-size="11"
                        fill="#526359"
                    >
                        {{ line }}
                    </text>
                {% endfor %}
                {% for line in node.patch %}
                    <text
                        x="0"
                        y="{{
                        node.labelY + (node.label|length) * 17 + (node.notes|length) * 13
                            + loop.index0 * 12
                        }}"
                        font-size="10"
                        font-weight="bold"
                        fill="#24483f"
                    >
                        {{ line }}
                    </text>
                {% endfor %}
            </g>
        {% endfor %}
    </g>
</svg>
