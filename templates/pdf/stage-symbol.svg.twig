<g fill="none" stroke="#263e43" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {% if
        kind
            in [
                'mic_vocal',
                'mic_instrument',
                'stand_straight',
                'stand_boom',
                'di_mono',
                'di_stereo'
            ] %}
        {{
            include(
                'stage/_audio-symbol.svg.twig',
                {
                    kind: kind
                },
                with_context: false
            )
        }}
    {% elseif kind == 'amp' %}
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M8 5V2h8v3M3 10h18" />
        <circle cx="8" cy="8" r="0.5" />
        <circle cx="12" cy="8" r="0.5" />
        <circle cx="8" cy="15" r="2" />
        <circle cx="16" cy="15" r="2" />
    {% elseif kind == 'person' %}
        <circle cx="12" cy="4" r="3" />
        <path d="M5 23v-8a7 7 0 0 1 14 0v8M9 23v-8m6 8v-8" />
    {% elseif kind == 'keys' %}
        <rect x="2" y="4" width="20" height="16" rx="1" />
        <path d="M6 4v16m4-16v16m4-16v16m4-16v16M8 4v8m8-8v8" />
    {% elseif kind == 'wedge' %}
        <path d="m3 20 5-14h10l4 14H3Zm3-5h14M9 9h8m-9 3h10" />
    {% elseif kind == 'power' %}
        <path d="m14 1-9 13h7l-2 9 9-13h-7l2-9Z" />
    {% else %}
        <rect x="3" y="6" width="18" height="15" rx="2" />
        <path d="M8 6V3h8v3M3 11h18m-9 3v4" />
    {% endif %}
</g>
