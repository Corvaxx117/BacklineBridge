<article class="task-card" data-task-id="{{ task.id }}" aria-labelledby="task-title-{{ task.id }}">
    <h3 id="task-title-{{ task.id }}">
        {% if is_granted('TASK_EDIT', task) %}
            <a
                href="{{
                path(
                    'app_task_edit',
                    {
                        id: task.id
                    }
                )
                }}"
            >
                {{ task.title }}
            </a>
        {% else %}
            {{ task.title }}
        {% endif %}
    </h3>
    <div class="task-meta">
        <span class="task-assignee {{ task.assignee ? '' : 'task-unassigned' }}">
            {{ task.assignee ? task.assignee.publicName : 'Non attribuée' }}
        </span>
        {% if task.dueAt %}
            <span class="task-due {{ task.overdue(today) ? 'task-overdue' : '' }}">
                {{ task.overdue(today) ? 'En retard · ' : 'Pour le ' }}<time datetime="{{ task.dueAt|date('Y-m-d') }}">{{
                        task.dueAt|date('d/m/Y')
                    }}</time>
            </span>
        {% endif %}
    </div>
    {% if task.description %}
        <details class="task-description">
            <summary>
                Précisions
            </summary>
            <p>
                {{- task.description -}}
            </p>
        </details>
    {% endif %}
    <p class="task-author">
        Créée par {{ task.createdByName }} · {{ task.createdAt|date('d/m/Y') }}
    </p>
    {% if task.completedAt %}
        <p class="task-completed">
            Terminée le {{ task.completedAt|date('d/m/Y') }}
        </p>
    {% endif %}
    {% if is_granted('TASK_EDIT', task) %}
        {% if task.status.value == 'todo' %}
            {% set state_actions = {
                doing: 'Commencer',
                done: 'Terminer'
            } %}
        {% elseif task.status.value == 'doing' %}
            {% set state_actions = {
                done: 'Terminer',
                todo: 'Remettre à faire'
            } %}
        {% else %}
            {% set state_actions = {
                todo: 'Réouvrir'
            } %}
        {% endif %}
        <div class="task-card-actions" role="group" aria-label="Actions pour {{ task.title }}">
            <form
                method="post"
                action="{{
                path(
                    'app_task_state',
                    {
                        id: task.id
                    }
                )
                }}"
                class="task-state-form"
                aria-label="Changer l’état de {{ task.title }}"
            >
                <input
                    type="hidden"
                    name="task_state[_token]"
                    value="{{ csrf_token('task_state_' ~ task.id) }}"
                />
                <input type="hidden" name="task_state[revision]" value="{{ task.revision }}" />
                {% for value, label in state_actions %}
                    <button
                        type="submit"
                        class="task-action {{
                        loop.first and task.status.value != 'done'
                            ? 'task-action-primary'
                            : ''
                        }}"
                        name="task_state[status]"
                        value="{{ value }}"
                        title="{{ label }}"
                        aria-label="{{ label }}"
                    >
                        {{
                            include(
                                'task/_icon.html.twig',
                                {
                                    icon: value
                                },
                                with_context: false
                            )
                        }}
                        <span class="visually-hidden">{{ label }}</span>
                    </button>
                {% endfor %}
            </form>
            <div class="task-card-links">
                <a
                    class="task-action"
                    href="{{
                    path(
                        'app_task_edit',
                        {
                            id: task.id
                        }
                    )
                    }}"
                    title="Modifier"
                    aria-label="Modifier"
                >
                    {{
                        include(
                            'task/_icon.html.twig',
                            {
                                icon: 'edit'
                            },
                            with_context: false
                        )
                    }}
                    <span class="visually-hidden">Modifier</span>
                </a>
                {% if is_granted('TASK_DELETE', task) %}
                    <a
                        class="task-action task-action-danger"
                        href="{{
                        path(
                            'app_task_delete',
                            {
                                id: task.id
                            }
                        )
                        }}"
                        title="Supprimer"
                        aria-label="Supprimer"
                    >
                        {{
                            include(
                                'task/_icon.html.twig',
                                {
                                    icon: 'delete'
                                },
                                with_context: false
                            )
                        }}
                        <span class="visually-hidden">Supprimer</span>
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
</article>
