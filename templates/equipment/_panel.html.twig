{% set groups = {} %}
{% for item in sheet.equipmentRequests %}
    {% set category = item.category|trim ? : 'Autre' %}
    {% set categoryKey = 'category_' ~ category %}
    {% set groups =
        groups|merge({
            (categoryKey): groups[categoryKey]|default([])|merge([item])
        })
    %}
{% endfor %}
{% set categoryIcons = {
    Batterie: 'drums',
    Amplification: 'amp',
    'Scène': 'stage',
    Retours: 'monitor',
    'Façade': 'speaker'
} %}

<section class="technical-panel equipment-panel" aria-labelledby="equipment-title">
    <div class="panel-header">
        <div>
            <p class="eyebrow">
                Batterie, amplification et accueil
            </p>
            <h2 id="equipment-title">Matériel à prévoir</h2>
        </div>
        {% if is_granted('SHEET_MANAGE', sheet) %}
            <a
                class="button button-secondary"
                href="{{
                path(
                    'app_equipment_edit',
                    {
                        id: sheet.id
                    }
                )
                }}"
            >
                Adapter le matériel
            </a>
        {% endif %}
    </div>

    {% if groups %}
        <details class="equipment-content" open>
            <summary>
                <span>
                    Détail du matériel <span class="equipment-summary-count">{{
                            sheet.equipmentRequests|length
                        }} demande{{ (sheet.equipmentRequests|length) > 1 ? 's' : '' }} · {{
                            groups|length
                        }} catégorie{{ (groups|length) > 1 ? 's' : '' }}</span>
                </span>
                <svg
                    class="equipment-chevron"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    aria-hidden="true"
                    focusable="false"
                >
                    <path d="m9 5 7 7-7 7" />
                </svg>
            </summary>
            <div class="equipment-groups">
                {% for items in groups %}
                    {% set category = items|first.category|trim ? : 'Autre' %}
                    {% set icon = categoryIcons[category]|default('gear') %}
                    <section
                        class="equipment-group equipment-group-{{ icon }}"
                        aria-labelledby="equipment-category-{{ loop.index }}"
                    >
                        <header class="equipment-group-header">
                            <span class="equipment-category-icon">
                                {{
                                    include(
                                        'equipment/_category_icon.html.twig',
                                        {
                                            icon: icon
                                        },
                                        with_context: false
                                    )
                                }}
                            </span>
                            <h3 id="equipment-category-{{ loop.index }}">{{ category }}</h3>
                            <span class="equipment-category-count">
                                {{ items|length }} demande{{ (items|length) > 1 ? 's' : '' }}
                            </span>
                        </header>
                        <ul class="equipment-items">
                            {% for item in items %}
                                <li class="equipment-item">
                                    <span class="equipment-quantity">
                                        <span class="visually-hidden">Quantité :</span>
                                        <span aria-hidden="true">×</span>{{ item.quantity }}
                                    </span>
                                    <div class="equipment-item-copy">
                                        <strong>{{ item.label }}</strong>
                                        {% if item.specification %}
                                            <p>
                                                {{ item.specification }}
                                            </p>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>
        </details>
    {% else %}
        <p class="panel-message">
            Aucun équipement ajouté pour le moment.
        </p>
    {% endif %}
    <p class="panel-footer">
        Les demandes sont des préférences. Le matériel réellement proposé par la salle sera précisé
        dans sa réponse.
    </p>
</section>
