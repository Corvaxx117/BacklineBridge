<svg
    width="25"
    height="25"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {% if icon == 'drums' %}
        <ellipse cx="12" cy="7" rx="8" ry="3" />
        <path
            d="M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3M8 10v8m8-8v8M5 2l5 3m9-3-5 3"
        />
    {% elseif icon == 'amp' %}
        <rect x="2.5" y="5" width="19" height="15" rx="2" />
        <path d="M3 10h18M7 5V3h10v2M6 8h1m3 0h1m3 0h1m3 0h.1" />
        <circle cx="8" cy="15" r="2.5" />
        <circle cx="16" cy="15" r="2.5" />
    {% elseif icon == 'stage' %}
        <path d="m3 10 9-5 9 5-9 5-9-5Zm0 0v7l9 5 9-5v-7M12 15v7M7 2v5m10-5v5" />
    {% elseif icon == 'monitor' %}
        <path d="m3 19 4-12h10l4 12H3Zm4-12 4 12m-3-8h8m-7 4h9M3 19v2h18v-2" />
    {% elseif icon == 'speaker' %}
        <rect x="6" y="2" width="12" height="20" rx="2" />
        <circle cx="12" cy="7" r="1.5" />
        <circle cx="12" cy="15" r="3.5" />
    {% else %}
        <rect x="3" y="7" width="18" height="14" rx="2" />
        <path d="M8 7V3h8v4M3 12h18m-13 0v3m8-3v3" />
    {% endif %}
</svg>
