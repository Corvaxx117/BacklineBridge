{
    "name": "backlinebridge-tools",
    "private": true,
    "scripts": {
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "calendar:assets": "node tools/frontend/calendar-assets.mjs",
        "calendar:assets:check": "node tools/frontend/calendar-assets.mjs --check",
        "test:frontend": "node --test tests/Frontend/*.test.mjs",
        "assets": "node tools/frontend/assets.mjs",
        "assets:check": "node tools/frontend/assets.mjs --check",
        "lint:frontend": "node tools/frontend/check-syntax.mjs",
        "test:browser": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@zackad/prettier-plugin-twig": "^0.17.0",
        "esbuild": "0.28.2",
        "prettier": "^3.6.2"
    },
    "dependencies": {
        "fullcalendar": "^7.1.3"
    },
    "engines": {
        "node": ">=22"
    }
}
